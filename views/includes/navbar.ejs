<body>
  
  <style>
    .fa-magnifying-glass{
      font-size: 12px;
      color: white;
      margin-right: 4px;
      display: inline;
      align-items: center;
    }
.btn-outline-success{
  height: 34px;
  color: rgb(255, 255, 255);
  background-color:#fe424d ;
  outline: none;
  border: none;
  border-radius: 25px;
  padding: 0 1rem 0 1rem;
  
}
.search-inp{
  border-radius: 25px;
  padding: 0.5rem 3rem 0.5 rem 3rem;
}

  </style>

  <nav class="navbar navbar-expand-lg bg-body-light sticky-top border-bottom"> 
    <div class="container-fluid"> 
      <a class="navbar-brand" href="/listings">
        <i class="fa-regular fa-compass"></i>
        
      </a> 
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation"> 
        <span class="navbar-toggler-icon"></span> 
      </button> 
      <div class="collapse navbar-collapse" id="navbarNavAltMarkup"> 
        <div class="navbar-nav"> 
          <a class="nav-link" href="/listings">Explore</a> 
          
        </div> 
<div class="navbar-nav ms-auto">
  <form class="d-flex align-items-center" role="search">
    <!-- Styled search input with custom rounded pill borders -->
    <input class="form-control me-2 search-inp" type="search" placeholder="Search destinations" aria-label="Search"/>
    
    <!-- Corrected Bootstrap button element -->
    <button class="btn btn-outline-success d-flex align-items-center " type="submit">
      <i class="fa-solid fa-magnifying-glass "></i> Search
    </button>
  </form>
</div>


        <div class="navbar-nav ms-auto"> 
          <a class="nav-link" href="/listings/new">Add New Listing</a> 
          <% if(!currUser) { %> 
            <a class="nav-link" href="/signup">Signup</a> 
            <a class="nav-link" href="/login">Login</a> 
          <% } %> 
          <% if(currUser) { %> 
            <a class="nav-link" href="/logout">Logout</a> 
          <% } %> 
        </div> 
      </div> 
    </div> 
  </nav> 
