<% layout("/layouts/boilerplate") %>

<!-- Kept clean and properly wrapped to avoid breaking inline compilation -->
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-3">
    <!-- Title Section -->
    <div class="col-8 offset-3">
        <h3><%= listing.title %></h3>
    </div>

    <!-- Main Listing Card -->
    <div class="card col-6 offset-3 listing-card mt-2">
        <img src="<%= listing.image.url %>" alt="Listing Image" class="card-img-top">
        <div class="card-body">
            <p class="card-text small text-muted"><i>Hosted By: <%= listing.owner?.username %></i></p>
            <p class="card-text"><%= listing.description %></p>
            <% if(listing.price) { %>
                <p class="card-text">₹ <%= listing.price.toLocaleString("en-IN") %></p>
            <% } %>
            <p class="card-text"><%= listing.location %></p>
            <p class="card-text"><%= listing.country %></p>
        </div>
    </div>

    <!-- Action Buttons for Owner Only -->
    <% if (currUser && listing.owner && (currUser._id.toString() === listing.owner._id.toString() || currUser._id.equals(listing.owner._id))) { %>
        <div class="btns mb-5 mt-3 d-flex gap-2 col-6 offset-3 px-0">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn col-2">Edit</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                <button class="btn btn-danger">Delete</button>
            </form>
        </div>
    <% } %>

    <!-- Review Section wrapper -->
    <div class="col-8 offset-3 mb-3">
        <hr>
        <% if(currUser){ %>
            <h4>Leave a Review</h4>
            <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>  
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" cols="30" rows="5" id="comment" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add some text for your review.</div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
        <% } %>

        <!-- Display Reviews Array -->
        <% if(listing.reviews && listing.reviews.length > 0) { %>
            <h4 class="mt-4">All Reviews</h4>
            <div class="row">
                <% for(let review of listing.reviews) { %>
                    <div class="card col-5 ms-3 mb-3 p-2"> 
                        <div class="card-body">      
                            <h5 class="card-title">@<%= review.author?.username || "anonymous" %></h5>
                            <!-- Added static space padding inside standard starability-result layout classes -->
                            <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                            <p class="card-text mb-2"><%= review.comment %></p>
                            
                            <!-- Check if current user is the author of this specific review before displaying delete button -->
                            <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
                                <form method="POST" class="mb-1" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                    <button class="btn btn-sm btn-dark">Delete</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- Map Container Block -->
    <div class="col-8 mb-4 offset-3">
        <h3>Where you'll be</h3>
        <div id="map"></div>
    </div>
</div>

<script src="/js/map.js"></script>
