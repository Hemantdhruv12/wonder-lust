<% layout("/layouts/boilerplate") %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3>Edit Listing</h3>
      <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        
        <!-- Title -->
        <div class="mb-3">
          <label自动 for="title" class="form-label">Title</label>
          <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required>
          <div class="invalid-feedback">Please enter a title.</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea name="listing[description]" class="form-control" rows="4" required><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a short description.</div>
        </div>

        <div class="mb-3 col-6">
  Preview Image
  <img src="<%= originalUrl %>" 
        
       class="img-thumbnail" 
       style="width: 300px; height: 200px; object-fit: cover;">
</div>

        <!-- Image URL -->
        <div class="mb-3">
          <label for="image" class="form-label">upload new image</label>
          <input name="listing[image]" type="file" class="form-control">
          
        </div>

        <!-- Price -->
        <div class="mb-3">
          <label for="price" class="form-label">Price</label>
          <input name="listing[price]" type="number" value="<%= listing.price %>" class="form-control" required>
          <div class="invalid-feedback">Please enter a valid price.</div>
        </div>

        <!-- Country -->
        <div class="mb-3">
          <label for="country" class="form-label">Country</label>
          <input name="listing[country]" type="text" value="<%= listing.country %>" class="form-control" required>
          <div class="invalid-feedback">Please enter the country name.</div>
        </div>

        <!-- Location -->
        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input name="listing[location]" type="text" value="<%= listing.location %>" class="form-control" required>
          <div class="invalid-feedback">Please enter a location.</div>
        </div>

        <button class="btn btn-dark add-btn">Save Changes</button>
      </form>
    </div>
  </div>
</body>
